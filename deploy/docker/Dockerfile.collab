# Build context: repository root
FROM node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY apps/collab/package.json apps/collab/
RUN npm ci -w @archcanvas/collab --include-workspace-root
COPY apps/collab apps/collab
RUN npm run build -w @archcanvas/collab && npm prune --omit=dev -w @archcanvas/collab

FROM node:22-alpine
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/collab/package.json ./apps/collab/package.json
COPY --from=build /app/apps/collab/dist ./apps/collab/dist
USER 1000
EXPOSE 1234
CMD ["node", "apps/collab/dist/index.js"]
