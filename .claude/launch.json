{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "db",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev:db"],
      "port": 5432
    },
    {
      "name": "api",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=.env", "node_modules/tsx/dist/cli.mjs", "watch", "apps/api/src/index.ts"],
      "port": 8082
    },
    {
      "name": "web",
      "runtimeExecutable": "node",
      "runtimeArgs": ["--env-file=.env", "node_modules/vite/bin/vite.js", "apps/web", "--port", "5174", "--strictPort"],
      "port": 5174
    }
  ]
}
