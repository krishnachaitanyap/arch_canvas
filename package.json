{
  "name": "archcanvas",
  "version": "0.1.0",
  "private": true,
  "description": "AI-native architecture diagramming platform. Cloud (GCP) and self-hosted from one codebase.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @archcanvas/web",
    "dev:api": "npm run dev -w @archcanvas/api",
    "dev:collab": "npm run dev -w @archcanvas/collab",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "migrate": "npm run migrate -w @archcanvas/api",
    "dev:db": "node scripts/dev-db.mjs",
    "dev:api:sqlite": "node scripts/dev-api-sqlite.mjs",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "embedded-postgres": "^19.0.0-beta.20",
    "vitest": "^5.1.2"
  }
}
