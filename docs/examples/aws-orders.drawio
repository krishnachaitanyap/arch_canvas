<mxfile host="app.diagrams.net">
  <diagram id="orders" name="Orders platform (AWS)">
    <mxGraphModel grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="users" value="Shoppers" style="sketch=0;outlineConnect=0;fontColor=#232F3E;shape=mxgraph.aws4.users;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="-160" y="230" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cloud" value="AWS Cloud" style="points=[];shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_aws_cloud_alt;strokeColor=#232F3E;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;container=1;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="900" height="640" as="geometry" /></mxCell>
        <mxCell id="vpc" value="VPC" style="points=[];shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_vpc;strokeColor=#248814;fillColor=none;verticalAlign=top;align=left;spacingLeft=30;container=1;" vertex="1" parent="cloud"><mxGeometry x="40" y="40" width="820" height="460" as="geometry" /></mxCell>
        <mxCell id="subnet" value="Private subnet 10.0.1.0/24" style="points=[];shape=mxgraph.aws4.group;grIcon=mxgraph.aws4.group_security_group;strokeColor=#147EBA;fillColor=#E6F2F8;verticalAlign=top;align=left;spacingLeft=30;container=1;" vertex="1" parent="vpc"><mxGeometry x="280" y="50" width="500" height="380" as="geometry" /></mxCell>
        <mxCell id="alb" value="ALB" style="sketch=0;outlineConnect=0;fillColor=#8C4FFF;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.application_load_balancer;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="vpc"><mxGeometry x="80" y="180" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="fn" value="Orders service" style="sketch=0;outlineConnect=0;fillColor=#ED7100;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.fargate;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="subnet"><mxGeometry x="60" y="140" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="rds" value="Orders DB" style="sketch=0;outlineConnect=0;fillColor=#C925D1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="subnet"><mxGeometry x="300" y="60" width="60" height="60" as="geometry" /></mxCell>
        <mxCell id="cache" value="Sessions" style="sketch=0;outlineConnect=0;fillColor=#C925D1;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.elasticache;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="subnet"><mxGeometry x="300" y="240" width="60" height="60" as="geometry" /></mxCell>
