        <mxCell id="sqs" value="Order events" style="sketch=0;outlineConnect=0;fillColor=#E7157B;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.sqs;verticalLabelPosition=bottom;verticalAlign=top;" vertex="1" parent="cloud"><mxGeometry x="420" y="540" width="60" height="60" as="geometry" /></mxCell>
