<mxfile host="app.diagrams.net">
  <diagram id="flow" name="Order fulfilment">
    <mxGraphModel grid="1" gridSize="10">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="start" value="Order received" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="200" y="0" width="160" height="50" as="geometry" /></mxCell>
        <mxCell id="input" value="Read order details" style="shape=parallelogram;perimeter=parallelogramPerimeter;whiteSpace=wrap;html=1;fixedSize=1;" vertex="1" parent="1"><mxGeometry x="190" y="90" width="180" height="60" as="geometry" /></mxCell>
        <mxCell id="stock" value="In stock?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="205" y="190" width="150" height="100" as="geometry" /></mxCell>
        <mxCell id="reserve" value="Reserve items" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="200" y="340" width="160" height="60" as="geometry" /></mxCell>
        <mxCell id="backorder" value="Create back-order" style="shape=process;whiteSpace=wrap;html=1;backgroundOutline=1;" vertex="1" parent="1"><mxGeometry x="440" y="210" width="170" height="60" as="geometry" /></mxCell>
        <mxCell id="db" value="Orders DB" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=12;" vertex="1" parent="1"><mxGeometry x="10" y="330" width="110" height="80" as="geometry" /></mxCell>
        <mxCell id="invoice" value="Invoice" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;" vertex="1" parent="1"><mxGeometry x="210" y="450" width="140" height="70" as="geometry" /></mxCell>
        <mxCell id="end" value="Done" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1"><mxGeometry x="220" y="560" width="120" height="44" as="geometry" /></mxCell>
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="start" target="input"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="input" target="stock"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" value="yes" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="stock" target="reserve"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" value="no" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;strokeColor=#b85450;" edge="1" parent="1" source="stock" target="backorder"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" value="writes" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;endArrow=open;endFill=0;" edge="1" parent="1" source="reserve" target="db"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e6" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="reserve" target="invoice"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e7" style="edgeStyle=orthogonalEdgeStyle;html=1;endArrow=block;endFill=1;" edge="1" parent="1" source="invoice" target="end"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e8" value="retry later" style="edgeStyle=orthogonalEdgeStyle;html=1;dashed=1;dashPattern=1 3;endArrow=block;endFill=0;" edge="1" parent="1" source="backorder" target="stock"><mxGeometry relative="1" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
