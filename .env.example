# ---------- API ----------
PORT=8080
DATABASE_URL=postgres://archcanvas:archcanvas@localhost:5432/archcanvas
# Local fallback without Postgres (Node 22.13+; no tenant isolation, single user):
# DATABASE_URL=sqlite:.data/archcanvas.sqlite
CORS_ORIGIN=http://localhost:5173

# Auth. Leave OIDC_ISSUER empty for local dev (auth disabled, single "default" tenant).
# Cloud: Keycloak / Identity Platform. Self-hosted: the customer's Keycloak, Okta or Entra ID.
OIDC_ISSUER=
OIDC_AUDIENCE=archcanvas
# JWT claim that carries the tenant id (falls back to "default")
TENANT_CLAIM=tenant

# ---------- LLM gateway ----------
# gemini | anthropic | vertex | openai_compatible | none
LLM_PROVIDER=gemini
# Check the current model id at https://ai.google.dev/gemini-api/docs/models
LLM_MODEL=gemini-3.8-flash
# Gemini API key (Google AI Studio). Leave empty to use Gemini on Vertex AI with VERTEX_PROJECT_ID / VERTEX_REGION.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Vertex AI — used when LLM_PROVIDER=vertex (Claude) or LLM_PROVIDER=gemini without GEMINI_API_KEY
VERTEX_PROJECT_ID=
VERTEX_REGION=us-east5

# Any OpenAI-compatible endpoint (vLLM, Ollama, Azure OpenAI, LiteLLM) — used when LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=not-needed

# ---------- Collab ----------
COLLAB_PORT=1234

# ---------- Web (dev proxy) ----------
# Where Vite forwards /api in dev (defaults to http://localhost:8080)
API_PROXY_TARGET=

# ---------- IaC ----------
# Terraform binary used to validate generated code (optional; validation is skipped if missing)
TERRAFORM_BIN=terraform
