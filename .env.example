# ---------- API ----------
PORT=8080
DATABASE_URL=postgres://archcanvas:archcanvas@localhost:5432/archcanvas
CORS_ORIGIN=http://localhost:5173

# Auth. Leave OIDC_ISSUER empty for local dev (auth disabled, single "default" tenant).
# Cloud: Keycloak / Identity Platform. Self-hosted: the customer's Keycloak, Okta or Entra ID.
OIDC_ISSUER=
OIDC_AUDIENCE=archcanvas
# JWT claim that carries the tenant id (falls back to "default")
TENANT_CLAIM=tenant

# ---------- LLM gateway ----------
# anthropic | vertex | openai_compatible | none
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=

# Vertex AI (Claude on GCP) — used when LLM_PROVIDER=vertex
VERTEX_PROJECT_ID=
VERTEX_REGION=us-east5

# Any OpenAI-compatible endpoint (vLLM, Ollama, Azure OpenAI, LiteLLM) — used when LLM_PROVIDER=openai_compatible
OPENAI_BASE_URL=http://localhost:11434/v1
OPENAI_API_KEY=not-needed

# ---------- Collab ----------
COLLAB_PORT=1234
